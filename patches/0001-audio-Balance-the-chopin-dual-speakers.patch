From d8c6f6698b7cdc840500ccacfe51e3980fdaa343 Mon Sep 17 00:00:00 2001
From: q2wip <q2inrus@gmail.com>
Date: Fri, 13 Nov 2026 23:52:14 +0800
Subject: [PATCH] audio: Balance the chopin dual speakers

The top (RCV) CS35L41 is much more sensitive than the bottom (AMP) one, so media playback is dominated by the earpiece while the bottom speaker is barely audible and distorts on loud peaks. Lower the RCV media gain from 16 to 4 and raise the AMP gain from 17 to 20; voice speakerphone still uses its own 14 value.
---
 proprietary/vendor/etc/audio_device.xml | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/proprietary/vendor/etc/audio_device.xml b/proprietary/vendor/etc/audio_device.xml
index 3b8952b..c4486e7 100644
--- a/proprietary/vendor/etc/audio_device.xml
+++ b/proprietary/vendor/etc/audio_device.xml
@@ -14,7 +14,7 @@
         <kctl name="RCV DSP1 Preload Switch" value="1" />
         <kctl name="RCV PCM Source" value="DSP" />
         <kctl name="RCV PCM Soft Ramp" value="4ms" />
-        <kctl name="RCV AMP PCM Gain" value="16" />
+        <kctl name="RCV AMP PCM Gain" value="4" />
         <kctl name="RCV ASP TX1 Source" value="DSPTX1" />
         <kctl name="RCV ASP TX2 Source" value="Zero" />
         <kctl name="RCV ASPTX Ref" value="Ref" />
@@ -27,7 +27,7 @@
         <kctl name="DSP1 Preload Switch" value="1" />
         <kctl name="PCM Source" value="DSP" />
         <kctl name="PCM Soft Ramp" value="4ms" />
-        <kctl name="AMP PCM Gain" value="17" />
+        <kctl name="AMP PCM Gain" value="20" />
         <kctl name="ASP TX1 Source" value="Zero" />
         <kctl name="ASP TX2 Source" value="DSPTX1" />
         <kctl name="DSP RX1 Source" value="ASPRX2" />
@@ -86,6 +86,8 @@
         <path name="speaker_output" value="turnon">
             <kctl name="DAC In Mux" value="Normal Path" />
             <kctl name="LOL Mux" value="Playback" />
+            <kctl name="AMP PCM Gain" value="20" />
+            <kctl name="RCV AMP PCM Gain" value="4" />
         </path>
         <path name="speaker_output" value="turnoff">
             <kctl name="LOL Mux" value="Open" />
@@ -138,7 +140,7 @@
         <path name="VOICE_SPK_OUT_DEVICE_CTRL_PRE_PMU" value="turnoff">
             <kctl name="RCV Fast Use Case Switch Enable" value="0"/>
             <kctl name="Fast Use Case Switch Enable" value="0"/>
-            <kctl name="RCV AMP PCM Gain" value="16" />
+            <kctl name="RCV AMP PCM Gain" value="4" />
         </path>
         <!--headhpone_speaker output-->
         <path name="headphoneSpeaker_output" value="turnon">
-- 
2.53.0

