From 427f97bd140ad80a4f10b861dbb7e03f896dd67e Mon Sep 17 00:00:00 2001
From: q2wip <q2inrus@gmail.com>
Date: Thu, 12 Nov 2026 18:54:44 +0800
Subject: [PATCH] wifi: Build wifi_hal_fn from vendor symbols via dlsym

The chopin vendor libwifi-hal-mtk.so is from MIUI 14 (Android 12) and does not have the newer slots of AOSP wifi_hal_legacy_fn, which shifted the whole function table and made unrelated callbacks crash. Assemble the table by resolving every symbol with dlsym instead.
---
 wlan/libwifi-hal-wrapper/libwifi-hal.cpp | 339 +++++++++++------------
 1 file changed, 162 insertions(+), 177 deletions(-)

diff --git a/wlan/libwifi-hal-wrapper/libwifi-hal.cpp b/wlan/libwifi-hal-wrapper/libwifi-hal.cpp
index 0fba82e..2ccc770 100644
--- a/wlan/libwifi-hal-wrapper/libwifi-hal.cpp
+++ b/wlan/libwifi-hal-wrapper/libwifi-hal.cpp
@@ -24,205 +24,190 @@
         }                                         \
     } while (0)
 
-static wifi_hal_legacy_fn* fln = nullptr;
 static void* lib_handle = nullptr;
 
+extern "C" wifi_error wifi_stub_not_supported() {
+    return WIFI_ERROR_NOT_SUPPORTED;
+}
+
+#define SET_BY_DLSYM(fn_ptr, member)                     \
+    do {                                                 \
+        void* _sym = dlsym(lib_handle, #member);          \
+        (fn_ptr)->member = _sym                          \
+            ? reinterpret_cast<decltype((fn_ptr)->member)>(_sym) \
+            : reinterpret_cast<decltype((fn_ptr)->member)>(wifi_stub_not_supported); \
+    } while (0)
+
 wifi_error init_wifi_vendor_hal_func_table(wifi_hal_fn* fn) {
-    init_wifi_vendor_hal_func_table_legacy_t init_fn;
     wifi_error ret = WIFI_ERROR_NONE;
 
-    fln = (wifi_hal_legacy_fn*)calloc(1, sizeof(wifi_hal_legacy_fn));
-    if (!fln) {
-        ret = WIFI_ERROR_OUT_OF_MEMORY;
-        goto out;
-    }
-
     lib_handle = dlopen(WIFI_HAL_LIB_NAME, RTLD_LAZY);
     if (!lib_handle) {
         ALOGE("Failed to open vendor library %s.", WIFI_HAL_LIB_NAME);
-        ret = WIFI_ERROR_UNKNOWN;
-        goto error;
+        return WIFI_ERROR_UNKNOWN;
     }
 
-    init_fn = (init_wifi_vendor_hal_func_table_legacy_t)dlsym(lib_handle, WIFI_HAL_INIT_FUNC_NAME);
-    if (!init_fn) {
-        ALOGE("Failed to locate vendor HAL init function.");
-        ret = WIFI_ERROR_UNKNOWN;
-        goto error;
-    }
-
-    ret = init_fn(fln);
-    if (ret != WIFI_ERROR_NONE) {
-        ALOGE("Vendor HAL init function returns %d.", ret);
-        goto error;
-    }
